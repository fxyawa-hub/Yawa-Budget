# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional external API base URL (defaults to /api)
VITE_API_BASE_URL="/api"

# VITE_DEMO_MODE: When "true", frontend runs in self-contained browser mock mode. When "false", calls real backend.
VITE_DEMO_MODE="true"

# Paystack Sandbox API (test-mode money transfer / send flow)
# Falls back to realistic sandbox simulation if omitted
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"

# Spring Boot & MongoDB Backend Configuration (NIIT Defense Core Backend)
MONGODB_URI="mongodb://localhost:27017/yawa_budget"
JWT_SECRET="yawa-budget-super-secret-jwt-key-niit-defense-2026-minimum-256-bits!"
JWT_EXPIRATION_MS="86400000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
SEED_DATA_ENABLED="true"
